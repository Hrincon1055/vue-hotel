# =============================================
# Variables de entorno para PRODUCCIÓN (Docker)
# Nginx hace proxy de /api/* al backend
# =============================================

# URL de la API (relativa, Nginx redirige a la API)
VITE_API_URL=/api/v1

# Keys para localStorage
VITE_ACCESS_TOKEN_KEY=access_token
VITE_REFRESH_TOKEN_KEY=refresh_token
VITE_USER_KEY=user
VITE_REMEMBER_EMAIL_KEY=remember_email
